<?xml version="1.0"?>
<robot name="base101" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Force-disable the sim ros2_control + per-sim extensions so this URDF is
       safe to load on real hardware. Xacro takes the first <xacro:arg> for a
       given name, so declaring simulator=none here before the include
       overrides the description's default. -->
  <xacro:arg name="simulator" default="none"/>
  <xacro:include filename="$(find base101_description)/urdf/base101.xacro"/>

  <!-- No <ros2_control> block: locomotion bypasses ros2_control entirely on
       real hardware. The Axon 2 firmware owns the DDSM210 wheel drivers and
       talks ROS topics directly over zenoh — it subscribes to /cmd_vel and
       publishes /odom — so there is no per-wheel command/state interface for
       a SystemInterface to bridge. See HARDWARE.md. -->

</robot>
