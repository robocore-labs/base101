<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>base101_bringup_hw</name>
  <version>0.1.0</version>
  <description>
    Hardware bringup for base101: one launch that starts robot_state_publisher
    + twist_mux and the autonomy stack. There is no ros2_control on real
    hardware — the Axon 2 firmware owns locomotion directly over zenoh
    (/cmd_vel in, /odom out). Also owns the RViz-only display launch. The
    counterpart of base101_bringup_gazebo, sharing its argument contract so
    sim and robot are driven the same way.
  </description>

  <maintainer email="cristian@robocore.dev">Cristian Dragomir</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Model + tuning -->
  <exec_depend>base101_description</exec_depend>
  <exec_depend>base101_control</exec_depend>

  <!-- Stacks this composes -->
  <exec_depend>base101_slam</exec_depend>
  <exec_depend>base101_nav</exec_depend>
  <exec_depend>robocore_agent</exec_depend>

  <!-- Runtime -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rosboard</exec_depend>

  <!-- display.launch.py only -->
  <exec_depend>rviz2</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
