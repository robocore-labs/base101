; PIO UART TX program
; 8N1 format, LSB first
; Autopull with 8-bit threshold

.program pio_uart_tx
.side_set 1 opt

    pull       side 1 [7]  ; Wait for data, keep TX high (idle)
    set x, 7   side 0 [7]  ; Start bit (low), 8 data bits to send
bitloop:
    out pins, 1             ; Shift 1 bit from OSR to TX pin
    jmp x-- bitloop    [6]  ; Loop for 8 bits
    pull ifempty side 1 [7] ; Stop bit (high), try to pull next byte

% c-sdk {
static inline void pio_uart_tx_program_init(PIO pio, uint sm, uint offset, uint pin_tx, uint baud) {
    pio_gpio_init(pio, pin_tx);
    // Mark TX as an output. The old `1u << pin_tx` masks are undefined for
    // pin >= 32 (the DDSM motors on GP32-39) and ignore the PIO GPIO base, so
    // they drove the wrong pins. pio_sm_set_consecutive_pindirs is base-aware.
    // The line idles high via the program's `pull side 1` once enabled.
    pio_sm_set_consecutive_pindirs(pio, sm, pin_tx, 1, true);

    pio_sm_config c = pio_uart_tx_program_get_default_config(offset);
    sm_config_set_out_shift(&c, true, false, 32);  // Shift right, no autopull
    sm_config_set_out_pins(&c, pin_tx, 1);
    sm_config_set_sideset_pins(&c, pin_tx);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    // Each bit takes 8 cycles (1 instruction + [7] delay) at the clock divider rate
    float div = (float)clock_get_hz(clk_sys) / (8 * baud);
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
