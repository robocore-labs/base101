pter_1.stl" scale="0.001 0.001 0.001"/></geometry><material name="body_darkgrey"/></visual><collision><origin rpy="0 0 0" xyz="-0.0132667 -0.0186206 -2.32544e-07"/><geometry><box size="0.0538862 0.0493 0.0273769"/></geometry></collision></link><joint name="arm_fixed_servo_shoulder_1" type="fixed"><origin rpy="0 0 0" xyz="0.05886 -0.015997 -0.006584"/><parent link="arm_shoulder_rotation_link_1"/><child link="arm_servo_shoulder_1"/></joint><joint name="arm_joint_shoulder" type="revolute"><origin rpy="0 0 0" xyz="-0.01025 0.0352 0.03275"/><parent link="arm_servo_shoulder_1"/><child link="arm_shoulder_adapter_1"/><axis xyz="0.0 1.0 0.0"/><!-- lower is -0.001, not 0.0: the hard stop is at 0, but Gazebo settles the
       joint at ~-1e-12 rad and MoveIt's CheckStartStateBounds adapter then
       rejects the start state and aborts the whole planning pipeline before
       OMPL runs. 1 mrad of margin is mechanically negligible and ~9 orders of
       magnitude above the noise. Real encoders do the same thing. --><limit effort="100" lower="-0.001" upper="3.141593" velocity="100"/><dynamics damping="1.0" friction="0.1"/></joint><!-- Upper-arm rail: 2020 box primitive, length = shoulder_ext_length, running
     from this frame to the elbow joint along -X. --><link name="arm_arm_extrusion_1"><inertial><origin rpy="0 0 0" xyz="-0.07 0 0"/><mass value="0.06440000000000001"/><inertia ixx="4.293333333333334e-06" ixy="0" ixz="0" iyy="0.00010733333333333337" iyz="0" izz="0.00010733333333333337"/></inertial><visual><origin rpy="0 0 0" xyz="-0.07 0 0"/><geometry><box size="0.14 0.02 0.02"/></geometry><material name="silver"/></visual><collision><origin rpy="0 0 0" xyz="-0.07 0 0"/><geometry><box size="0.14 0.02 0.02"/></geometry></collision></link><link name="arm_elbow_link_1"><inertial><origin rpy="0 0 0" xyz="-0.010386839428546318 0.00039485016823848085 -0.0020812304383783786"/><mass value="0.0310526039"/><inertia ixx="9.55261389e-06" ixy="-1.80237998e-07" ixz="-2.70356997e-07" iyy="7.93047191e-06" iyz="9.01189989e-08" izz="1.37882068e-05"/></inertial><visual><origin rpy="0 0 0" xyz="0.062581 -0.073858 -0.142215"/><geometry><mesh filename="file:///bpe/docker/.sim/install/mod101_description/share/mod101_description/meshes/elbow_link_1.stl" scale="0.001 0.001 0.001"/></geometry><material name="body_darkgrey"/></visual><collision><origin rpy="0 0 0" xyz="-0.0108048 0.000550375 0.00151226"/><geometry><box size="0.0536101 0.0493 0.029825"/></geometry></collision></link><link name="arm_servo_elbow_1"><inertial><origin rpy="0 0 0" xyz="0.010248900428017363 0.014922520716508098 0.018164022574663097"/><mass value="0.0658962961901927"/><inertia ixx="1.8e-05" ixy="0.0" ixz="-0.0" iyy="1.4e-05" iyz="0.0" izz="1e-05"/></inertial><visual><origin rpy="0 0 0" xyz="0.097041 -0.058988 -0.14589"/><geometry><mesh filename="file:///bpe/docker/.sim/install/mod101_description/share/mod101_description/meshes/servo_elbow_1.stl" scale="0.001 0.001 0.001"/></geometry><material name="motor_black"/></visual><collision><origin rpy="0 0 0" xyz="0.0102501 0.0154997 0.0164998"/><geometry><box size="0.0247234 0.0378 0.0452234"/></geometry></collision></link><link name="arm_elbow_adapter_1"><inertial><origin rpy="0 0 0" xyz="0.020137826276852483 0.018502164445195313 0.00029332039965654366"/><mass value="0.0245465749"/><inertia ixx="8.64713056e-06" ixy="0" ixz="-1.15295074e-07" iyy="5.30357341e-06" iyz="-0" izz="1.11836222e-05"/></inertial><visual><origin rpy="0 0 0" xyz="0.086791 -0.055588 -0.17489"/><geometry><mesh filename="file:///bpe/docker/.sim/install/mod101_description/share/mod101_description/meshes/elbow_adapter_1.stl" scale="0.001 0.001 0.001"/></geometry><material name="body_darkgrey"/></visual><collision><origin rpy="0 0 0" xyz="0.0132671 0.0186204 -2.29492e-07"/><geometry><box size="0.0538862 0.0493 0.0273769"/></geometry></collision></link><joint name="arm_fixed_servo_elbow_1" type="fixed"><origin rpy="0 0 0" xyz="-0.03446 -0.01487 0.003675"/><parent link="arm_elbow_link_1"/><child link="arm_servo_elbow_1"/></joint><joint name="arm_joint_elbow" type="revolute"><origin rpy="0 0 0" xyz="0.01025 -0.0034 0.029"/><parent link="arm_servo_elbow_1"/><child link="arm_elbow_adapter_1"/><axis xyz="0.0 -1.0 0.0"/><!-- lower is -0.001, not 0.0: the hard stop is at 0, but Gazebo settles the
       joint at ~-1e-12 rad and MoveIt's CheckStartStateBounds adapter then
       rejects the start state and aborts the whole planning pipeline before
       OMPL runs. 1 mrad of margin is mechanically negligible and ~9 orders of
       magnitude above the noise. Real encoders do the same thing. --><limit effort="100" lower="-0.001" upper="3.141593" velocity="100"/><dynamics damping="1.0" friction="0.1"/></joint><!-- Forearm rail: 2020 box primitive, length = elbow_ext_length, running from
     this frame to the wrist along +X. --><link name="arm_forearm_extrusion_1"><inertial><origin rpy="0 0 0" xyz="0.07 0 0"/><mass value="0.06440000000000001"/><inertia ixx="4.293333333333334e-06" ixy="0" ixz="0" iyy="0.00010733333333333337" iyz="0" izz="0.00010733333333333337"/></inertial><visual><origin rpy="0 0 0" xyz="0.07 0 0"/><geometry><box size="0.14 0.02 0.02"/></geometry><material name="silver"/></visual><collision><origin rpy="0 0 0" xyz="0.07 0 0"/><geometry><box size="0.14 0.02 0.02"/></geometry></collision></link><link name="arm_wrist_servo_adapter_1"><inertial><origin rpy="0 0 0" xyz="-0.0019161875719076876 -0.001239865018947961 -8.234763106684806e-07"/><mass value="0.0198664172"/><inertia ixx="6.06215668e-06" ixy="1.1022103e-07" ixz="0" iyy="2.42486267e-06" iyz="0" izz="5.62127255e-06"/></inertial><visual><origin rpy="0 0 0" xyz="-0.035419 -0.074758 -0.173765"/><geometry><mesh filename="file:///bpe/docker/.sim/install/mod101_description/share/mod101_description/meshes/wrist_servo_adapter_1.stl" scale="0.001 0.001 0.001"/></geometry><material name="body_darkgrey"/></visual><collision><origin rpy="0 0 0" xyz="0.000500196 -0.000549624 -2.37122e-07"/><geometry><box size="0.033 0.0493 0.0268"/></geometry></collision></link><link name="arm_servo_wrist_tilt_1"><inertial><origin rpy="0 0 0" xyz="0.02191445288807735 -0.01687680721527879 -0.010249015260752697"/><mass value="0.0658962961901927"/><inertia ixx="1e-05" ixy="0.0" ixz="0.0" iyy="1.4e-05" iyz="-0.0" izz="1.8e-05"/></inertial><visual><origin rpy="0 0 0" xyz="-0.045069 -0.090758 -0.184015"/><geometry><mesh filename="file:///bpe/docker/.sim/install/mod101_description/share/mod101_description/meshes/servo_wrist_tilt_1.stl" scale="0.001 0.001 0.001"/></geometry><material name="motor_black"/></visual><collision><origin rpy="0 0 0" xyz="0.0202502 -0.0162996 -0.0102502"/><geometry><box size="0.0452234 0.0378 0.0247234"/></geometry></collision></link><link name="arm_wrist_roll_adapter_1"><inertial><origin rpy="0 0 0" xyz="0.0265390165786311 0.018652019649215763 0.02086935983869931"/><mass value="0.0264696078"/><inertia ixx="1.56325077e-05" ixy="-0" ixz="-6.22533494e-06" iyy="1.77076194e-05" iyz="0" izz="1.27273514e-05"/></inertial><visual><origin rpy="0 0 0" xyz="-0.077819 -0.055558 -0.173765"/><geometry><mesh filename="file:///bpe/docker/.sim/install/mod101_description/share/mod101_description/meshes/wrist_roll_adapter_1.stl" scale="0.001 0.001 0.001"/></geometry><material name="body_darkgrey"/></visual><collision><origin rpy="0 0 0" xyz="0.0256497 0.0186504 0.0177044"/><geometry><box size="0.073299 0.0493 0.0573908"/></geometry></collision></link><link name="arm_servo_wrist_rotation_1"><inertial><origin rpy="0 0 0" xyz="-0.01512262078899361 -0.010248404686314716 -0.018164491466766297"/><mass value="0.0658962961901927"/><inertia ixx="1.4e-05" ixy="0.0" ixz="0.0" iyy="1.8e-05" iyz="-0.0" izz="1e-05"/></inertial><visual><origin rpy="0 0 0" xyz="-0.137219 -0.084458 -0.202765"/><geometry><mesh filename="file:///bpe/docker/.sim/install/mod101_description/share/mod101_description/meshes/servo_wrist_rotation_1.stl" scale="0.001 0.001 0.001"/></geometry><material name="motor_black"/></visual><collision><origin rpy="0 0 0" xyz="-0.0156998 -0.0102496 -0.0165002"/><geometry><box size="0.0378 0.0247234 0.0452234"/></geometry></collision></link><link name="arm_camera_adapter_1"><inertial><origin rpy="0 0 0" xyz="-0.015133427944392153 -0.00999962387213657 0.00491529865458315"/><mass value="0.011514241"/><inertia ixx="2.68600122e-06" ixy="0" ixz="-0" iyy="2.21200101e-06" iyz="-0" izz="4.26600194e-06"/></inertial><visual><origin rpy="0 0 0" xyz="-0.135219 -0.084908 -0.220165"/><geometry><mesh filename="file:///bpe/docker/.sim/install/mod101_description/share/mod101_description/meshes/camera_adapter_1.stl" scale="0.001 0.001 0.001"/></geometry><material name="accent_green"/></visual><collision><origin rpy="0 0 0" xyz="-0.0140503 -0.00999963 0.00747259"/><geometry><box size="0.042699 0.0388 0.0210544"/></geometry></collision></link><link name="arm_camera_wing_1"><inertial><origin rpy="0 0 0" xyz="0.14361888944153076 0.3347919124721062 -0.15696687867817244"/><mass value="0.0104777712"/><inertia ixx="4.26511024e-06" ixy="0" ixz="7.89835229e-07" iyy="3.94917615e-06" iyz="-0" izz="1.42170341e-06"/></inertial><visual><origin rpy="0 0 0" xyz="0.025688 0.259707 -0.40513"/><geometry><mesh filename="file:///bpe/docker/.sim/install/mod101_description/share/mod101_description/meshes/camera_wing_1.stl" scale="0.001 0.001 0.001"/></geometry><material name="accent_green"/></visual><collision><origin rpy="0 0 0" xyz="0.143097 0.334715 -0.148664"/><geometry><box size="0.0276196 0.031 0.0625861"/></geometry></collision></link><link name="arm_wrist_camera_v1_1"><inertial><origin rpy="0 0 0" xyz="-0.005107415957823297 0.012044156369510242 -0.01085870058537286"/><mass value="0.0166"/><inertia ixx="9.97708548e-07" ixy="-0" ixz="-0" iyy="9.97708548e-07" iyz="0" izz="9.97708548e-07"/></inertial><visual><origin rpy="0 0 0" xyz="-0.115073 -0.062344 -0.284896"/><geometry><mesh filename="file:///bpe/docker/.sim/install/mod101_description/share/mod101_description/meshes/wrist_camera_v1_1.stl" scale="0.001 0.001 0.001"/></geometry><material name="body_darkgrey"/></visual><collision><origin rpy="0 0 0" xyz="-0.00532676 0.0119999 -0.010453"/><geometry><box size="0.0149472 0.028 0.0262219"/></geometry></collision></link><!-- Wrist flange: the mount contract for tool packages (docs/tool-convention.md).
     Massless frame on the wrist-roll servo's output horn; the active tool bolts
     its root link here with an identity fixed joint. +X outward, +Z up. --><link name="arm_wrist_flange"><inertial><origin rpy="0 0 0" xyz="0 0 0"/><mass value="0.001"/><inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06"/></inertial></link><!-- ===================== joints (canonical names, export axes) ============== --><joint name="arm_fixed_servo_base_1" type="fixed"><origin rpy="0 0 0" xyz="-0.026600194 0.010920221 0.050000344"/><parent link="arm_base_link"/><child link="arm_servo_base_1"/></joint><joint name="arm_fixed_base_cover_1" type="fixed"><origin rpy="0 0 0" xyz="-0.038504194 -0.014879779 0.033800344"/><parent link="arm_base_link"/><child link="arm_base_cover_1"/></joint><joint name="arm_joint_base" type="revolute"><origin rpy="0 0 0" xyz="0.029 -0.01025 0.0032"/><parent link="arm_servo_base_1"/><child link="arm_shoulder_rotation_link_1"/><axis xyz="0.0 0.0 1.0"/><limit effort="100" lower="-1.570796" upper="1.570796" velocity="100"/><dynamics damping="1.0" friction="0.1"/></joint><!-- fixed_servo_shoulder_1 + joint_shoulder are defined inside the shoulder module. --><joint name="arm_fixed_arm_extrusion_1" type="fixed"><origin rpy="0 0 0" xyz="-0.02421 -0.019171 -0.001125"/><parent link="arm_shoulder_adapter_1"/><child link="arm_arm_extrusion_1"/></joint><!-- Upper-arm rail advance (editable via shoulder_ext_length). --><joint name="arm_fixed_elbow_link_1" type="fixed"><origin rpy="0 0 0" xyz="-0.14 0.0 0.0"/><parent link="arm_arm_extrusion_1"/><child link="arm_elbow_link_1"/></joint><!-- fixed_servo_elbow_1 + joint_elbow are defined inside the elbow module. --><joint name="arm_fixed_forearm_extrusion_1" type="fixed"><origin rpy="0 0 0" xyz="0.02421 0.01917 -0.001125"/><parent link="arm_elbow_adapter_1"/><child link="arm_forearm_extrusion_1"/></joint><!-- Forearm rail advance (editable via elbow_ext_length). --><joint name="arm_fixed_wrist_servo_adapter_1" type="fixed"><origin rpy="0 0 0" xyz="0.14 0.0 0.0"/><parent link="arm_forearm_extrusion_1"/><child link="arm_wrist_servo_adapter_1"/></joint><joint name="arm_fixed_servo_wrist_tilt_1" type="fixed"><origin rpy="0 0 0" xyz="0.00965 0.016 0.01025"/><parent link="arm_wrist_servo_adapter_1"/><child link="arm_servo_wrist_tilt_1"/></joint><!-- joint_wrist_tilt: export axis 0 -1 0.
     Travel measured on the configurator: -1.23 .. 1.54 rad. Was `continuous`
     (no lower/upper), which left the joint unbounded in the `arm` group: pick_ik
     has no interval to sample, rejects its own seed with "Initial guess exceeds
     joint limits", and every plan aborts. Bounded servo travel => revolute. --><joint name="arm_joint_wrist_tilt" type="revolute"><origin rpy="0 0 0" xyz="0.03275 -0.0352 -0.01025"/><parent link="arm_servo_wrist_tilt_1"/><child link="arm_wrist_roll_adapter_1"/><axis xyz="0.0 -1.0 0.0"/><limit effort="100" lower="-1.23" upper="1.54" velocity="100"/><dynamics damping="1.0" friction="0.1"/></joint><!-- Wrist roll: fixed in the exports (the actuated 5th DOF + tool flange come
     with the tool work, later). --><joint name="arm_fixed_servo_wrist_rotation_1" type="fixed"><origin rpy="0 0 0" xyz="0.0594 0.0289 0.029"/><parent link="arm_wrist_roll_adapter_1"/><child link="arm_servo_wrist_rotation_1"/></joint><!-- joint_wrist_roll: the actuated 5th DOF. The servo BODY is fixed to the
     wrist_roll_adapter above; this joint is its output horn, driving the
     wrist_flange (and hence the tool).

     Origin/axis are derived from the export's own servo geometry rather than
     measured separately: servo_wrist_rotation_1 is the same STS3215 part as
     servo_base_1, rotated +90 deg about Y. Its inertia tensor is servo_base_1's
     with ixx/izz swapped, and its COM is servo_base_1's COM under
     (x,y,z) -> (z,y,-x) — both confirm that rotation exactly. Applying the same
     map to joint_base's output (0.029, -0.01025, 0.0032) about axis +Z gives
     the values below, about axis +X. +X is outward, per docs/tool-convention.md.

     The flange sits ON the horn face: any adapter/spacer plate belongs to the
     tool package, not here (tool-convention.md, "What this means for the mount
     joint"). FIXME: confirm against CAD if a flange plate is ever added.

     Travel: 180 deg from the zero pose, i.e. 0 .. pi, matching how joint_shoulder
     and joint_elbow are expressed. Was `continuous` (no lower/upper), which left
     it unbounded in the `arm` group — same failure as joint_wrist_tilt. --><joint name="arm_joint_wrist_roll" type="revolute"><origin rpy="0 0 0" xyz="0.0032 -0.01025 -0.029"/><parent link="arm_servo_wrist_rotation_1"/><child link="arm_wrist_flange"/><axis xyz="1.0 0.0 0.0"/><limit effort="100" lower="0.0" upper="3.141593" velocity="100"/><dynamics damping="1.0" friction="0.1"/></joint><joint name="arm_fixed_camera_adapter_1" type="fixed"><origin rpy="0 0 0" xyz="0.0574 0.02935 0.0464"/><parent link="arm_wrist_roll_adapter_1"/><child link="arm_camera_adapter_1"/></joint><joint name="arm_fixed_camera_wing_1" type="fixed"><origin rpy="0 0 0" xyz="-0.160907 -0.344615 0.184965"/><parent link="arm_camera_adapter_1"/><child link="arm_camera_wing_1"/></joint><joint name="arm_fixed_wrist_camera_v1_1" type="fixed"><origin rpy="0 0 0" xyz="0.140761 0.322051 -0.120234"/><parent link="arm_camera_wing_1"/><child link="arm_wrist_camera_v1_1"/></joint><!-- Optical frame for the wrist camera (REP-103: +Z out of the lens, +X right,
     +Y down). `wrist_camera_v1_1` is the *body* frame, +X out of the lens, which
     is what Gazebo points the sensor along. ROS image consumers assume the
     optical convention instead, so the sensor stamps its messages with this
     frame — see mod101.gazebo's gz_frame_id.

     Same rotation base101's chassis camera uses (chassis.xacro,
     camera_optical_frame). Zero translation: the lens offset within the body
     link has not been measured against CAD, so this frame sits at the link
     origin. Fix the offset here if you need metric accuracy from the images. --><link name="arm_wrist_camera_optical_frame"/><joint name="arm_wrist_camera_optical_joint" type="fixed"><origin rpy="-1.570796 0 -1.570796" xyz="0 0 0"/><parent link="arm_wrist_camera_v1_1"/><child link="arm_wrist_camera_optical_frame"/></joint><ros2_control name="arm_mod101_sim_system" type="system"><hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware><!-- Arm joints (5 DOF). End-effector joints live in the active tool's own
         <ros2_control> block; see mod101_tool_<tool>/urdf/tool.ros2control. --><joint name="arm_joint_base"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint><joint name="arm_joint_shoulder"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint><joint name="arm_joint_elbow"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint><joint name="arm_joint_wrist_tilt"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint><joint name="arm_joint_wrist_roll"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint></ros2_control><gazebo reference="arm_base_link"><material>Gazebo/DarkGrey</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>true</self_collide><gravity>true</gravity></gazebo><gazebo reference="arm_servo_base_1"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>true</self_collide></gazebo><gazebo reference="arm_base_cover_1"><material>Gazebo/Green</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>true</self_collide></gazebo><gazebo reference="arm_shoulder_rotation_link_1"><material>Gazebo/DarkGrey</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>true</self_collide></gazebo><gazebo reference="arm_servo_shoulder_1"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>true</self_collide></gazebo><gazebo reference="arm_shoulder_adapter_1"><material>Gazebo/DarkGrey</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>true</self_collide></gazebo><gazebo reference="arm_arm_extrusion_1"><material>Gazebo/Silver</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>true</self_collide></gazebo><gazebo reference="arm_elbow_link_1"><material>Gazebo/DarkGrey</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>true</self_collide></gazebo><gazebo reference="arm_servo_elbow_1"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>true</self_collide></gazebo><gazebo reference="arm_elbow_adapter_1"><material>Gazebo/DarkGrey</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>true</self_collide></gazebo><gazebo reference="arm_forearm_extrusion_1"><material>Gazebo/Silver</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>true</self_collide></gazebo><gazebo reference="arm_wrist_servo_adapter_1"><material>Gazebo/DarkGrey</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>true</self_collide></gazebo><gazebo reference="arm_servo_wrist_tilt_1"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>true</self_collide></gazebo><gazebo reference="arm_wrist_roll_adapter_1"><material>Gazebo/DarkGrey</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>true</self_collide></gazebo><gazebo reference="arm_servo_wrist_rotation_1"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>true</self_collide></gazebo><gazebo reference="arm_camera_adapter_1"><material>Gazebo/Green</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>true</self_collide></gazebo><gazebo reference="arm_camera_wing_1"><material>Gazebo/Green</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>true</self_collide></gazebo><gazebo reference="arm_wrist_camera_v1_1"><material>Gazebo/DarkGrey</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>true</self_collide><sensor name="arm_wrist_camera" type="camera"><topic>arm_wrist_camera/image_raw</topic><!-- Stamp images with the optical frame, not the body link: ROS
         consumers assume REP-103 optical axes. The sensor still looks
         along the body link's +X, which is where Gazebo aims it. --><gz_frame_id>arm_wrist_camera_optical_frame</gz_frame_id><update_rate>30</update_rate><always_on>1</always_on><visualize>true</visualize><camera><horizontal_fov>1.047</horizontal_fov><!-- ~60 deg --><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.01</near><far>10.0</far></clip></camera></sensor></gazebo><!-- ============================================================
       Convention root: a tiny link at the bolt pattern.
       ============================================================ --><link name="arm_jaws_root"><inertial><origin rpy="0 0 0" xyz="0 0 0"/><mass value="0.001"/><inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/></inertial></link><joint name="arm_jaws_mount" type="fixed"><origin rpy="0 0 0" xyz="0 0 0"/><parent link="arm_wrist_flange"/><child link="arm_jaws_root"/></joint><!-- ============================================================
       SO-101 CAD-frame sub-tree.

       In the LLMy URDF, every mesh has visual_origin ≈ (-0.181, -0.005,
       -0.189) — the meshes are all authored at LLMy's CAD-assembly origin,
       and that offset brings them back to the wrist mount point. So the
       SO-101 bolt pattern (in the vendored sub-tree's "jaws_body" frame)
       sits at the link origin, but the SO-101 wrist-roll axis points along
       LLMy's (-0.637, 0, 0.771) instead of mod101's wrist_flange +X.

       jaws_cad_to_root encodes that rotation. Pitch ≈ 2.262 rad aligns the
       SO-101 wrist-roll axis onto wrist_flange's +X; the extra yaw of π
       flips the gripper around so it actually projects outward (the wrist-
       roll axis is symmetric, so the math alone couldn't tell which end
       was "front") instead of facing back into the wrist.
       ============================================================ --><joint name="arm_jaws_cad_to_root" type="fixed"><origin rpy="0 2.262 3.14159" xyz="0 0 0"/><parent link="arm_jaws_root"/><child link="arm_jaws_body"/></joint><link name="arm_jaws_body"><inertial><origin rpy="0 0 0" xyz="0.018214 -0.013763 -0.022966"/><mass value="0.0437956016"/><inertia ixx="2.58658586e-05" ixy="3.82109275e-06" ixz="8.03409246e-06" iyy="2.94909979e-05" iyz="-3.91906949e-06" izz="2.30245333e-05"/></inertial><visual><origin rpy="0 0 0" xyz="-0.181143 -0.004550 -0.189344"/><geometry><mesh filename="package://mod101_tool_jaws/meshes/Wrist_Roll_08c_v1_1.stl" scale="0.001 0.001 0.001"/></geometry><material name="accent_green"/></visual><collision><origin rpy="0 0 0" xyz="-0.181143 -0.004550 -0.189344"/><geometry><mesh filename="package://mod101_tool_jaws/meshes/Wrist_Roll_08c_v1_1.stl" scale="0.001 0.001 0.001"/></geometry></collision></link><link name="arm_jaws_servo"><inertial><origin rpy="0 0 0" xyz="-0.005824 -0.004501 -0.018111"/><mass value="0.066"/><inertia ixx="1.53380282e-05" ixy="0" ixz="-1.3943662e-06" iyy="9.29577465e-06" iyz="0" izz="1.60352113e-05"/></inertial><visual><origin rpy="0 0 0" xyz="-0.201679 -0.016450 -0.189613"/><geometry><mesh filename="package://mod101_tool_jaws/meshes/arm_gripper_servo_1.stl" scale="0.001 0.001 0.001"/></geometry><material name="motor_black"/></visual><collision><origin rpy="0 0 0" xyz="-0.201679 -0.016450 -0.189613"/><geometry><mesh filename="package://mod101_tool_jaws/meshes/arm_gripper_servo_1.stl" scale="0.001 0.001 0.001"/></geometry></collision></link><link name="arm_jaws_moving"><inertial><origin rpy="0 0 0" xyz="0.035386 -0.001620 -0.010188"/><mass value="0.0180803214"/><inertia ixx="6.02677379e-06" ixy="3.41138139e-07" ixz="2.6153924e-06" iyy="9.89300604e-06" iyz="-3.41138139e-07" izz="4.66222124e-06"/></inertial><visual><origin rpy="0 0 0" xyz="-0.181539 -0.024750 -0.159670"/><geometry><mesh filename="package://mod101_tool_jaws/meshes/Moving_Jaw_08d_v1_1.stl" scale="0.001 0.001 0.001"/></geometry><material name="accent_green"/></visual><collision><origin rpy="0 0 0" xyz="-0.181539 -0.024750 -0.159670"/><geometry><mesh filename="package://mod101_tool_jaws/meshes/Moving_Jaw_08d_v1_1.stl" scale="0.001 0.001 0.001"/></geometry></collision></link><!-- ============================================================
       Joints inside the SO-101 sub-tree
       (verbatim from LLMy so the three meshes stay registered)
       ============================================================ --><joint name="arm_jaws_servo_mount" type="fixed"><origin rpy="0 0 0" xyz="0.020536 0.011900 0.000269"/><parent link="arm_jaws_body"/><child link="arm_jaws_servo"/></joint><joint name="arm_6" type="revolute"><origin rpy="0 0 0" xyz="-0.020140 0.008300 -0.029943"/><parent link="arm_jaws_servo"/><child link="arm_jaws_moving"/><axis xyz="0.770795 0.000000 0.637083"/><limit effort="20.0" lower="0.0" upper="2.14" velocity="5.0"/><dynamics damping="1.0" friction="0.5"/></joint><!-- ============================================================
       ros2_control + gazebo extensions
       ============================================================ --><ros2_control name="arm_mod101_tool_jaws_system" type="system"><hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware><joint name="arm_6"><command_interface name="position"><param name="min">0.0</param><param name="max">2.14</param></command_interface><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"><param name="initial_value">0.0</param></state_interface></joint></ros2_control><gazebo reference="arm_jaws_body"><material>Gazebo/Green</material><mu1>0.4</mu1><mu2>0.4</mu2><self_collide>true</self_collide></gazebo><gazebo reference="arm_jaws_servo"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>true</self_collide></gazebo><!-- Bumped friction on the moving jaw — that's the contact surface. --><gazebo reference="arm_jaws_moving"><material>Gazebo/Green</material><mu1>1.0</mu1><mu2>1.0</mu2><self_collide>true</self_collide></gazebo><ros2_control name="base101_sim_system" type="system"><hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware><joint name="front_left_wheel_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint><joint name="front_right_wheel_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint><joint name="back_left_wheel_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint><joint name="back_right_wheel_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint></ros2_control><!-- Gazebo-only extensions for the shared chassis: visual materials, contact
     properties, and the three sensors. No gz_ros2_control plugin here, that
     block lives in each variant's top-level xacro so it can point at that
     variant's controllers.sim.yaml.

     self_collide is false on every link. The chassis is one rigid tree joined
     by fixed joints, so no two links can ever move into each other; leaving it
     on just asked the solver to test ~325 link pairs of full-resolution
     collision meshes on every step. Collision geometry itself is primitives
     (see scripts/collision_primitives.py), not the visual meshes.

     Sensors hang off the dedicated frame links declared in chassis.xacro
     (imu_link, lidar_frame, camera_link) rather than off the mesh links, so
     the published frame is the physical origin of the measurement. --><!-- ================================= IMU =================================
     The IMU is a chip on the link101 carrier board, not a separate module, so
     it reads out ~100 mm up and ~10 mm behind base_link. The EKF (ekf.sim.yaml
     imu0) and the robocore imu API both consume /sensors/imu in imu_link. --><gazebo reference="imu_link"><sensor name="base_imu" type="imu"><topic>sensors/imu</topic><gz_frame_id>imu_link</gz_frame_id><update_rate>100</update_rate><always_on>1</always_on><visualize>false</visualize></sensor></gazebo><!-- ================================ lidar ================================ --><gazebo reference="lidar_frame"><sensor name="lidar" type="gpu_lidar"><topic>scan</topic><gz_frame_id>lidar_frame</gz_frame_id><update_rate>10</update_rate><always_on>1</always_on><visualize>true</visualize><lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range></lidar></sensor></gazebo><!-- ====================== base camera (rgb + depth) ======================
     Both sensors sit on camera_link (front face of whichever module is
     fitted, +X out of the lens) so rgb and depth share intrinsics, stamps and
     frame: robocore's get_depth / get_synced / deproject / get_cloud all
     assume that pairing. Topic names stay /base_camera/* whichever camera the
     `camera` arg selects, so the gz bridges do not care.

     FRAME: messages are stamped with camera_optical_frame (REP-103 optical
     axes: z out of the lens, x right, y down), NOT camera_link. That is what
     the real drivers do — realsense2_camera sets both
     `camera_info.header.frame_id` and `img_msg->header.frame_id` from
     OPTICAL_FRAME_ID(), and depthai publishes oak_*_camera_optical_frame — so
     sim and hardware agree and nothing has to be re-taught when the real
     module goes on.

     Keeping ONE optical frame shared by rgb and depth is deliberate. Real
     hardware exposes a per-sensor frame each, but depth is normally aligned to
     colour (realsense `align_depth`), which publishes depth in the colour
     optical frame — the same pairing robocore's deprojection needs.

     ROBOCORE: the camera's profile entry must say `optical: true`. With
     `optical: false` robocore applies its OPTICAL_TO_LINK rotation to points
     that are already optical, and every deprojection is silently wrong by 90
     degrees. See docs/robocore-camera-frames.md. --><gazebo reference="camera_link"><sensor name="base_camera" type="camera"><topic>base_camera/image_raw</topic><gz_frame_id>camera_optical_frame</gz_frame_id><update_rate>15</update_rate><!-- 30 was not sustainable:
         both cameras achieved only ~24-26 Hz, dropping frames
         independently, and a burst drop on depth stalled it ~400 ms —
         long enough that no rgb/depth pair remained within tolerance.
         15 Hz is sustained, so the two stay in lockstep. --><always_on>1</always_on><visualize>true</visualize><camera><horizontal_fov>1.518</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.05</near><far>20.0</far></clip></camera></sensor><sensor name="base_camera_depth" type="depth_camera"><topic>base_camera/depth_image</topic><gz_frame_id>camera_optical_frame</gz_frame_id><update_rate>15</update_rate><!-- 30 was not sustainable:
         both cameras achieved only ~24-26 Hz, dropping frames
         independently, and a burst drop on depth stalled it ~400 ms —
         long enough that no rgb/depth pair remained within tolerance.
         15 Hz is sustained, so the two stay in lockstep. --><always_on>1</always_on><visualize>false</visualize><camera><horizontal_fov>1.518</horizontal_fov><image><width>640</width><height>480</height><format>R_FLOAT32</format></image><clip><near>0.05</near><far>20.0</far></clip></camera></sensor></gazebo><!-- ================================ frame ================================ --><gazebo reference="base_link"><material>Gazebo/Grey</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide><gravity>true</gravity></gazebo><gazebo reference="box_front_1"><material>Gazebo/DarkGrey</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="box_back_1"><material>Gazebo/DarkGrey</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="box_left_1"><material>Gazebo/DarkGrey</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="box_right_1"><material>Gazebo/DarkGrey</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><!-- ============================== drivetrain ==============================
     The rims carry the traction contact: high mu1 along fdir1, low mu2
     across, stiff contact (kp/kd). The hubs are non-colliding internals. --><gazebo reference="wheel_front_left_1"><material>Gazebo/Black</material><mu1>1.0</mu1><mu2>0.1</mu2><fdir1>1 0 0</fdir1><kp>10000000.0</kp><kd>1.0</kd><self_collide>false</self_collide></gazebo><gazebo reference="wheel_front_right_1"><material>Gazebo/Black</material><mu1>1.0</mu1><mu2>0.1</mu2><fdir1>1 0 0</fdir1><kp>10000000.0</kp><kd>1.0</kd><self_collide>false</self_collide></gazebo><gazebo reference="wheel_back_left_1"><material>Gazebo/Black</material><mu1>1.0</mu1><mu2>0.1</mu2><fdir1>1 0 0</fdir1><kp>10000000.0</kp><kd>1.0</kd><self_collide>false</self_collide></gazebo><gazebo reference="wheel_back_right_1"><material>Gazebo/Black</material><mu1>1.0</mu1><mu2>0.1</mu2><fdir1>1 0 0</fdir1><kp>10000000.0</kp><kd>1.0</kd><self_collide>false</self_collide></gazebo><gazebo reference="wheel_hub_front_left_1"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="wheel_hub_front_right_1"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="wheel_hub_back_left_1"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="wheel_hub_back_right_1"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="mount_front_left_1"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="mount_front_right_1"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="mount_back_left_1"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="mount_back_right_1"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><!-- =============================== bumpers =============================== --><gazebo reference="bumper_front_left_1"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="bumper_front_right_1"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="bumper_back_left_1"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="bumper_back_right_1"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><!-- ============================ payload deck ============================ --><gazebo reference="standoff_front_left_1"><material>Gazebo/Silver</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="standoff_front_right_1"><material>Gazebo/Silver</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="standoff_back_left_1"><material>Gazebo/Silver</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="standoff_back_right_1"><material>Gazebo/Silver</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="top_plate_1"><material>Gazebo/Grey</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><!-- ========================= mounts / accessories ========================= --><gazebo reference="lidar_mount_1"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="lidar_1"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="camera_edge_bracket_1"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="camera_realsense_1"><material>Gazebo/DarkGrey</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="jetson_mount_1"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="orin_simplified_1"><material>Gazebo/DarkGrey</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="orp_link101_mount_1"><material>Gazebo/Black</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><gazebo reference="link_101_1"><material>Gazebo/Green</material><mu1>0.2</mu1><mu2>0.2</mu2><self_collide>false</self_collide></gazebo><!-- gz_ros2_control creates the controller_manager when the model is
         spawned and loads this file onto it. One file for every
         configuration: it declares the arm controllers too, but declaring a
         controller only makes it spawnable by name — an armless robot never
         spawns them, so the extra entries cost nothing. The arm joints'
         own ros2_control blocks are emitted by the mod101 macro in
         arm.xacro (use_sim=true). --><gazebo><plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin"><parameters>/bpe/docker/.sim/install/base101_control/share/base101_control/config/controllers.sim.yaml</parameters></plugin></gazebo><!-- simulator=isaac: driven natively from base101_isaac (no ros2_control).
       simulator=none: real-hw ros2_control comes from base101_control's
       hardware xacro (base101.hardware.xacro). --></robot>